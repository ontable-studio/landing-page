{
	"permissions": {
		"deny": [
			"Read(./.env)",
			"Read(./.env.local)",
			"Read(./.env.*.local)",
			"Read(./.env.development)",
			"Read(./.env.production)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/prettier-on-edit.sh\""
					}
				]
			}
		]
	}
}
