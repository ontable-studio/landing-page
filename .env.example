# Copy this file to .env and adjust the values.
# Only variables prefixed with VITE_ are exposed to client code (import.meta.env.VITE_*).
VITE_APP_ENVIRONMENT="development"

# The address the site is published at, without a trailing slash. It builds every
# canonical link, Open Graph URL and the sitemap. Leave it empty on Vercel to use the
# project's production domain, or when it is the default below.
VITE_SITE_URL="https://landing-page-ontable.vercel.app"
